# Supabase (used by the optional generate-script edge function)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the multicultural-LLM FastAPI backend that the wizard POSTs its
# completed Profile to (POST /api/intake). Leave blank to use the same origin
# (when the wizard is served by the backend). For local dev with the backend on
# port 7860, the client already falls back to http://localhost:7860.
VITE_PIPELINE_API_BASE=
